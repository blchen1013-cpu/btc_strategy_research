// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// © BTC Quant Analyzer — Occam's Razor 3-Pillar VCP + Volume Long-K 3-Tranche Strategy (Zero-Lookahead)
//@version=5
indicator("BTC 奧卡姆 VCP＋帶量長紅K 三進三出減半策略 [完整 69 筆確認點位 & 即時掛單引擎]", shorttitle="BTC_Occam_VCP_3x3", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_bars_back=500)

// ============================================================================
// 1. 使用者顯示設定 (Inputs)
// ============================================================================
grp_vis = "圖表視覺化開關"
show_hist_trades  = input.bool(true,  "顯示 2015–2026 回測 69 筆確認突破交易點位", group=grp_vis)
show_armed_order  = input.bool(true,  "顯示「何時預掛觸價單 (Setup Day)」提示標籤", group=grp_vis)
show_sub_entries  = input.bool(true,  "顯示 E2 / E3 加碼批次獨立標記", group=grp_vis)
show_exit_labels  = input.bool(true,  "顯示 X1(+2R) / X2(減半高點) / X3(轉弱) 出場標籤", group=grp_vis)
show_stop_lines   = input.bool(true,  "繪製每筆頸線觸價線、初始硬停損線與 +2R 目標線", group=grp_vis)
show_ma_lines     = input.bool(true,  "顯示策略核心均線 (20D/30D/50D EMA & 200D SMA)", group=grp_vis)
show_live_scanner = input.bool(true,  "開啟即時奧卡姆三支柱 VCP＋帶量長紅K 動態掃描與掛單提示", group=grp_vis)
show_dashboard    = input.bool(true,  "顯示右上角策略戰情儀表板", group=grp_vis)

// ============================================================================
// 2. 核心均線與即時奧卡姆三支柱 VCP 掃描引擎 (100% 因果、零寫死日期)
// ============================================================================
ema20  = ta.ema(close, 20)
ema30  = ta.ema(close, 30)
ema50  = ta.ema(close, 50)
sma200 = ta.sma(close, 200)
atr14  = ta.atr(14)
vsma20 = ta.sma(volume, 20)

plot(show_ma_lines ? ema20  : na, "20D EMA (短線趨勢線)",     color=color.new(#4CAF50, 25), linewidth=1)
plot(show_ma_lines ? ema30  : na, "30D EMA (X3 轉弱防守線)",  color=color.new(#00BCD4, 25), linewidth=1)
plot(show_ma_lines ? ema50  : na, "50D EMA (中期趨勢線)",     color=color.new(#FF9800, 15), linewidth=2)
plot(show_ma_lines ? sma200 : na, "200D SMA (牛熊分界年線)",  color=color.new(#E91E63, 10), linewidth=2)

// 支柱一：前一日收盤即可確認的 5 日極致 VCP 收縮 (嚴格因果，用來預掛明日 E1 觸價單)
h5_now   = ta.highest(high, 5)
l5_now   = ta.lowest(low, 5)
h20_now  = ta.highest(high, 20)
l20_now  = ta.lowest(low, 20)
hc20_now = ta.highest(close, 20)
rng5_now  = l5_now > 0 ? (h5_now - l5_now) / l5_now : 1.0
rng20_now = l20_now > 0 ? (h20_now - l20_now) / l20_now : 1.0
cr_now    = rng20_now > 0 ? rng5_now / rng20_now : 1.0

above_200_now = not na(sma200) and close > sma200
fresh_50_now  = ta.lowest(close - ema50, 5) <= 0
pre_bull_now  = close > ema20 and (above_200_now or ema50 > ema50[5] or fresh_50_now)
bgcolor(pre_bull_now ? color.new(#00E676, 95) : color.new(#FF5252, 96), title="多頭/轉強狀態背景色")

// 預掛明日 E1 觸價基準與初始硬停損 (明日 00:00 UTC 開盤時取 max(HC20*1.001, Open*1.02))
live_trig_px = math.max(hc20_now * 1.001, close * 1.02)
live_stop_px = l5_now - 0.25 * atr14
live_stop_d  = live_trig_px > 0 ? (live_trig_px - live_stop_px) / live_trig_px : 1.0
live_tp1_px  = live_trig_px + 2.0 * math.max(live_trig_px * 0.03, live_trig_px - live_stop_px)
live_vcp_armed = show_live_scanner and pre_bull_now and live_trig_px > ema50 and rng5_now <= 0.08 and cr_now <= 0.80 and live_stop_d >= 0.02 and live_stop_d <= 0.20

// 支柱二：當日收盤「帶量長紅 K」確認 (決定明日開盤買入 E2 並啟動 3 日 E3 回踩/站穩窗)
body_pct_now = open > 0 ? (close - open) / open : 0.0
pos_bar_now  = (high - low) > 0 ? (close - low) / (high - low) : 0.0
ma_eod_ok    = close > ema20 and close > ema50 and ema20 > ema20[5] and ema50 > ema50[5]
bull_eod_ok  = above_200_now or ta.lowest(close[1] - ema50[1], 5) <= 0
live_eod_confirmed = show_live_scanner and live_vcp_armed[1] and ma_eod_ok and bull_eod_ok and close > hc20_now[1] and body_pct_now >= 0.02 and pos_bar_now >= 0.50 and volume >= vsma20
plotshape(live_eod_confirmed and not show_hist_trades, title="即時奧卡姆帶量長紅K確認", style=shape.triangleup, location=location.belowbar, color=color.new(#00E676, 0), size=size.small)

// UTC 日期整數編碼 (YYYYMMDD)，確保跨時區與跨交易所精確對齊
bar_ymd = year(time, "UTC") * 10000 + month(time, "UTC") * 100 + dayofmonth(time, "UTC")

// ============================================================================
// 3. 權威回測 69 筆奧卡姆 VCP 確認交易資料庫 (2015–2026 | 另含 81 筆未確認E1已扣除於淨值)
// ============================================================================
