var float[] a_e1_px = array.from(268.27, 267.87, 436.57, 468.67, 591.14, 629.76, 746.89, 757.37, 1090.62, 1190.15, 1209.88, 1272.38, 5429.79, 9567.46, 10011.74, 12063.21, 11982.78, 13858.46, 19420.06, 61776.42, 67030.82, 23757.69, 28846.56, 29203.66, 28474.7, 29492.33, 35973.74, 37983.17, 38021.86, 38472.98, 45968.58, 49042.85, 67334.85, 68582.82, 99805.03, 104056.37, 112138.18, 123276.31)
var int[] a_e2_ymd = array.from(20150706, 20151018, 20160421, 20160528, 0, 20161012, 0, 0, 20170222, 0, 0, 20170427, 20190424, 20200206, 0, 0, 20201022, 0, 20201201, 20210414, 20211109, 0, 0, 20230411, 20230622, 20231021, 0, 0, 0, 20231202, 20240109, 20240213, 0, 0, 0, 0, 20250711, 20250814)
var float[] a_e2_px = array.from(271.24, 271.04, 441.64, 473.27, 0.0, 641.19, 0.0, 0.0, 1115.36, 0.0, 0.0, 1282.52, 5574.29, 9622.63, 0.0, 0.0, 12808.04, 0.0, 19643.59, 63555.52, 67583.51, 0.0, 0.0, 29668.51, 30010.93, 29698.22, 0.0, 0.0, 0.0, 38708.62, 47011.13, 49966.33, 0.0, 0.0, 0.0, 0.0, 116044.23, 123401.07)
