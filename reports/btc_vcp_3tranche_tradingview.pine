var float[] a_trig_px = array.from(268.13, 267.73, 436.35, 468.43, 590.85, 629.45, 746.52, 756.99, 1090.08, 1189.56, 1209.28, 1271.74, 5427.07, 9562.68, 10006.74, 12057.19, 11976.79, 13851.53, 19410.36, 61745.55, 66997.32, 23745.82, 28832.14, 29189.06, 28460.47, 29477.59, 35955.76, 37964.18, 38002.86, 38453.76, 45945.61, 49018.34, 67301.19, 68548.54, 99755.16, 104004.37, 112082.14, 123214.7)
