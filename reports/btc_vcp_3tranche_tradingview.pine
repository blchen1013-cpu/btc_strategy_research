var int[] a_x2_type = array.from(4, 2, 2, 2, 2, 2, 2, 2, 4, 2, 2, 2, 4, 4, 2, 4, 2, 2, 2, 4, 2, 4, 2, 4, 4, 2, 2, 2, 2, 2, 4, 2, 4, 4, 4, 4, 2, 4)
var int[] a_x3_ymd = array.from(20150809, 20151124, 20160521, 20160724, 20160724, 20170113, 20170113, 20170113, 20170319, 20170702, 20170702, 20170702, 20190717, 20200226, 20200620, 20200903, 20210125, 20210125, 20210125, 20210418, 20211118, 20230211, 20230422, 20230422, 20230725, 20240114, 20240114, 20240114, 20240114, 20240114, 20240117, 20240404, 20240615, 20240804, 20241224, 20241224, 20250802, 20250822)
