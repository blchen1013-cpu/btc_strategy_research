var int[] a_x1_ymd = array.from(20150818, 20151102, 20160528, 20160529, 20160616, 20161029, 20161223, 20161222, 20170324, 20170504, 20170501, 20170504, 20190511, 20200308, 20201021, 20200903, 20201117, 20201118, 20201226, 20210418, 20211118, 20230309, 20231109, 20230512, 20230817, 20231108, 20231204, 20240108, 20240102, 20240111, 20240119, 20240304, 20240624, 20240804, 20250113, 20250113, 20251017, 20250824)
var float[] a_x1_px = array.from(238.78, 335.43, 498.03, 540.92, 756.58, 705.51, 891.72, 843.01, 938.79, 1560.61, 1420.36, 1579.21, 6597.13, 8195.93, 12778.34, 10902.26, 16859.81, 17992.28, 26250.4, 54956.61, 57542.21, 20379.58, 37224.44, 26436.01, 25948.0, 35942.93, 41572.89, 46208.28, 44781.7, 48186.81, 40405.57, 65043.92, 59497.73, 58607.36, 89880.53, 90986.02, 104493.49, 111231.17)
var int[] a_x1_type = array.from(4, 1, 1, 1, 1, 1, 1, 1, 4, 1, 1, 1, 1, 4, 1, 4, 1, 1, 1, 4, 4, 4, 1, 4, 4, 1, 1, 1, 1, 1, 4, 1, 4, 4, 4, 4, 4, 4)
var int[] a_x2_ymd = array.from(20150818, 20171206, 20171206, 20171206, 20171206, 20171206, 20171206, 20171206, 20170324, 20171206, 20171206, 20171206, 20200312, 20200308, 20211008, 20200903, 20211008, 20211008, 20211008, 20210418, 20211109, 20230309, 20251005, 20230512, 20230817, 20251005, 20251005, 20251005, 20251005, 20251005, 20240119, 20251005, 20240624, 20240804, 20250113, 20250113, 20251005, 20250824)
