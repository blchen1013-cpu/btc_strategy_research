var float[] a_stop_pct = array.from(10.95, 11.95, 4.86, 6.98, 13.99, 4.25, 9.7, 5.65, 13.88, 15.56, 8.7, 9.73, 9.37, 14.29, 13.82, 9.58, 12.41, 14.91, 16.94, 10.99, 14.11, 14.18, 14.52, 9.43, 8.83, 10.51, 7.78, 10.83, 8.89, 7.97, 12.06, 15.31, 11.59, 14.5, 9.9, 12.52, 6.77, 9.73)
